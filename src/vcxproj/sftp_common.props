<?xml version="1.0" encoding="utf-8"?>
<!-- Shared settings for sftp.vcxproj and the lang_*.vcxproj projects.
     Standalone layout (mirrors Makefile.mingw): the Open Salamander SDK is expected
     next to this repo in ..\salamander-plugins\salamand. Override with
     /p:SalamanderSdkDir=<path to salamand dir> if it lives elsewhere. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <SftpRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</SftpRootDir>
    <SftpSrcDir>$(SftpRootDir)src\</SftpSrcDir>
    <SalamanderSdkDir Condition="'$(SalamanderSdkDir)'==''">$([System.IO.Path]::GetFullPath('$(SftpRootDir)..\salamander-plugins\salamand'))</SalamanderSdkDir>
    <SalamanderSdkDir Condition="!HasTrailingSlash('$(SalamanderSdkDir)')">$(SalamanderSdkDir)\</SalamanderSdkDir>
    <SalamanderSharedDir>$(SalamanderSdkDir)plugins\shared\</SalamanderSharedDir>
    <SftpOutDir>$(SftpRootDir)build\$(Configuration)_$(Platform)\</SftpOutDir>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateManifest>false</GenerateManifest>
    <EmbedManifest>false</EmbedManifest>
  </PropertyGroup>
  <Target Name="SftpCheckSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(SalamanderSharedDir)spl_base.h')"
           Text="Open Salamander SDK not found in '$(SalamanderSdkDir)'. Pass /p:SalamanderSdkDir=&lt;path to salamand dir&gt;." />
  </Target>
</Project>
